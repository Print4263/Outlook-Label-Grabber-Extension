{
  "manifest_version": 3,
  "name": "Domain Expansion: Print Label (Local)",
  "version": "0.3.0",
  "description": "Extracts and prints 4x6 shipping labels from Outlook using fully local detection — handles rotated labels, auto-orients results, and scales to low-resolution register screens. No backend required.",
  "permissions": [
    "storage",
    "downloads",
    "contextMenus",
    "sidePanel",
    "windows",
    "scripting",
    "tabs"
  ],
  "host_permissions": [
    "https://outlook.office.com/*",
    "https://outlook.office365.com/*",
    "https://outlook.live.com/*",
    "https://outlook.microsoft.com/*",
    "file:///*",
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://outlook.office.com/*",
        "https://outlook.office365.com/*",
        "https://outlook.live.com/*",
        "https://outlook.microsoft.com/*"
      ],
      "js": ["outlook-reader.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["<all_urls>"],
      "js": ["lib/label-drag-data.js", "page-label-drag.js"],
      "run_at": "document_idle",
      "all_frames": true
    }
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'"
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "Domain Expansion: Print Label",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  }
}
